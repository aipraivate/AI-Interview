MYSQL_DATABASE=interview
MYSQL_USER=interview
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
APP_CORS_ALLOWED_ORIGINS=https://interview.example.com
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# 正式接入兼容 OpenAI 协议的模型时启用；不配置则使用确定性的本地验收模型。
AI_PROVIDER=compatible
AI_BASE_URL=https://your-model-gateway.example.com/v1
AI_API_KEY=replace-with-secret-manager-reference
AI_MODEL=your-reviewed-model
